# The core calculation runs locally and needs no API key.
# Enter source folders in the application. Never commit private Excel files.

# Optional agent adapter. With a key, simple AI explanations use gpt-6-luna;
# an enhanced explanation or order preparation uses gpt-6-sol.
# Empty overrides keep these defaults.
# Export these variables in the process environment; .env is NOT loaded automatically.
AGENT_API_KEY=
AGENT_MODEL=
AGENT_MODEL_LIGHT=
AGENT_MODEL_COMPLEX=
AGENT_BASE_URL=https://api.openai.com/v1
